{
  "name": "taptalk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first TapTalk integration prototype",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "dev:iphone": "node scripts/serve.mjs --iphone",
